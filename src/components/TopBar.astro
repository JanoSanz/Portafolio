---
const items = [
  {
    view: "perfil",
    label: "STATUS",
    icon: "M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5z",
  },
  {
    view: "proyectos",
    label: "PROJECTS",
    icon: "M5 3h12a2 2 0 0 1 2 2v16l-5-3-3 2-3-2-5 3V5a2 2 0 0 1 2-2zm2 4v2h8V7H7zm0 4v2h8v-2H7z",
  },
  {
    view: "contacto",
    label: "LINK",
    icon: "M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z",
  },
];
---

<div class="bar">
  <div class="brand">
    <span class="brandDot" aria-hidden="true"></span>
    <span class="brandText">[ SYSTEM ]</span>
    <span class="brandSub">PLAYER&nbsp;v0.1</span>
  </div>

  <nav class="nav" aria-label="Secciones">
    {items.map((item) => (
      <a
        href={`#${item.view}`}
        data-view-link={item.view}
        data-nav={item.view}
        class="navBtn"
        aria-label={item.label}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={item.icon} /></svg>
        <span class="navLabel">{item.label}</span>
      </a>
    ))}
  </nav>
</div>

<style>
  .bar{
    height:56px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 16px;
    border-bottom:1px solid rgba(167,139,250,.22);
    background:
      linear-gradient(180deg, rgba(22,18,36,.92), rgba(10,8,18,.92));
    position:relative;
  }

  .bar::after{
    content:"";
    position:absolute;
    left:0; right:0; bottom:-1px;
    height:1px;
    background: linear-gradient(90deg, transparent, rgba(167,139,250,.7), transparent);
    box-shadow: 0 0 8px rgba(167,139,250,.4);
  }

  .brand{
    display:flex;
    align-items:center;
    gap:10px;
    font-family: "Rajdhani", system-ui, sans-serif;
  }

  .brandDot{
    width:8px; height:8px;
    border-radius:50%;
    background:#a78bfa;
    box-shadow:
      0 0 8px rgba(167,139,250,.9),
      0 0 18px rgba(167,139,250,.55);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse{
    0%, 100% { opacity:.6; transform:scale(.92); }
    50%      { opacity:1;  transform:scale(1.15); }
  }

  .brandText{
    font-weight:700;
    letter-spacing:3px;
    font-size:13px;
    color:#efeaff;
    text-shadow: 0 0 10px rgba(167,139,250,.5);
  }

  .brandSub{
    font-size:10px;
    letter-spacing:2px;
    color:#6a6680;
    text-transform:uppercase;
  }

  .nav{
    display:flex;
    gap:6px;
  }

  .navBtn{
    display:flex;
    align-items:center;
    gap:8px;
    padding:7px 14px;
    text-decoration:none;
    color:#a39ec0;
    border:1px solid rgba(167,139,250,.2);
    background: linear-gradient(180deg, rgba(28,22,46,.7), rgba(14,10,24,.7));
    font-family: "Rajdhani", system-ui, sans-serif;
    font-size:12px;
    font-weight:600;
    letter-spacing:2.5px;
    text-transform:uppercase;
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease, box-shadow 160ms ease;
  }

  .navBtn svg{
    width:15px; height:15px;
    fill: currentColor;
    opacity:.9;
  }

  .navBtn:hover,
  .navBtn:focus-visible{
    color:#f1ecff;
    border-color: rgba(167,139,250,.55);
    background: linear-gradient(180deg, rgba(52,36,90,.7), rgba(26,18,48,.7));
    outline:none;
  }

  .navBtn[data-active="true"]{
    color:#ffffff;
    border-color: rgba(167,139,250,.85);
    background: linear-gradient(180deg, rgba(85,55,140,.55), rgba(45,28,86,.55));
    box-shadow:
      0 0 0 1px rgba(167,139,250,.45),
      0 0 14px rgba(167,139,250,.5),
      inset 0 0 12px rgba(167,139,250,.2);
    text-shadow: 0 0 8px rgba(167,139,250,.65);
  }

  @media (max-width: 520px){
    .bar{ padding: 0 10px; }
    .brandSub{ display:none; }
    .navBtn{ padding: 6px 9px; letter-spacing: 1.5px; font-size: 11px; }
    .navBtn .navLabel{ display:none; }
    .navBtn svg{ width: 16px; height: 16px; }
  }
</style>
