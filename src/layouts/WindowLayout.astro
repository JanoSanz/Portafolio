---
import TopBar from "../components/TopBar.astro";
const { title = "Portafolio Jano L. Sanz" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/usuario.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800&family=Rajdhani:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>

  <body>
    <main class="wrap">
      <section class="window">
        <TopBar />
        <div class="content">
          <slot />
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*, *::before, *::after){ box-sizing: border-box; }

  :global(:root){
    /* Paleta principal: violeta moderno + grafito serio */
    --sys-violet: #a78bfa;
    --sys-violet-bright: #ddd6fe;
    --sys-violet-deep: #6d28d9;

    /* Fondos / superficies (negro azulado-grafito) */
    --sys-bg: #04030a;
    --sys-graphite: #14111e;
    --sys-panel: #0f0c1a;

    /* Bordes */
    --sys-border: rgba(167, 139, 250, .22);
    --sys-border-strong: rgba(167, 139, 250, .55);

    /* Texto: blanco con leve tinte violeta + grises neutros para seriedad */
    --sys-text: #f1ecff;
    --sys-text-dim: #a8a3c0;
    --sys-text-mute: #948fb5;

    --sys-glow: rgba(167, 139, 250, .38);

    --sys-font: "Rajdhani", system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
    --sys-font-title: "Orbitron", "Rajdhani", system-ui, sans-serif;
  }

  :global(body){
    margin:0;
    background:
      radial-gradient(1200px 700px at 30% 10%, #1a1230 0%, #0a0613 55%, #04020a 100%);
    color: var(--sys-text);
    font-family: var(--sys-font);
    overflow: hidden;
    position: relative;
    min-height: 100vh;
  }

  /* Halos de fondo */
  :global(body)::before{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:0;
    background:
      radial-gradient(900px 600px at 18% 18%, rgba(167,139,250,.14), transparent 60%),
      radial-gradient(800px 500px at 82% 82%, rgba(167,139,250,.08), transparent 60%);
  }

  /* Scanlines holográficas */
  :global(body)::after{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:0;
    opacity:.07;
    background:
      repeating-linear-gradient(
        180deg,
        rgba(167,139,250,.55) 0,
        rgba(167,139,250,.55) 1px,
        transparent 1px,
        transparent 3px
      );
    mix-blend-mode: screen;
  }

  .wrap{
    min-height:100vh;
    display:grid;
    place-items:center;
    padding:24px;
    position:relative;
    z-index:1;
  }

  .window{
    width: min(1120px, 100%);
    height: min(740px, calc(100vh - 48px));
    border: 1px solid var(--sys-border-strong);
    background:
      linear-gradient(180deg, rgba(22,17,38,.92), rgba(10,7,18,.96));
    box-shadow:
      0 0 0 1px rgba(167,139,250,.12),
      0 0 38px rgba(167,139,250,.20),
      0 22px 80px rgba(0,0,0,.75),
      inset 0 0 60px rgba(167,139,250,.06);
    clip-path: polygon(
      18px 0,
      100% 0,
      100% calc(100% - 18px),
      calc(100% - 18px) 100%,
      0 100%,
      0 18px
    );
    animation: systemOpen 620ms cubic-bezier(.2,.85,.2,1) both;
    transform-origin: center;
    position: relative;
  }

  /* Brackets brillantes en esquinas */
  .window::before,
  .window::after{
    content:"";
    position:absolute;
    width:22px;
    height:22px;
    border: 1.5px solid var(--sys-violet-bright);
    pointer-events:none;
    z-index:5;
    filter: drop-shadow(0 0 4px var(--sys-glow));
  }
  .window::before{
    top:0; left:0;
    border-right:none;
    border-bottom:none;
  }
  .window::after{
    bottom:0; right:0;
    border-left:none;
    border-top:none;
  }

  .content{
    height: calc(100% - 56px);
    padding: 16px;
    display:flex;
    flex-direction:column;
    min-height:0;
    overflow: hidden;
    position: relative;
  }

  @keyframes systemOpen{
    0%{
      opacity:0;
      transform: scale(.94);
      filter: blur(10px) brightness(2.4);
    }
    55%{
      opacity:1;
      filter: blur(0) brightness(1.6);
    }
    100%{
      opacity:1;
      transform: scale(1);
      filter: blur(0) brightness(1);
    }
  }

  @media (prefers-reduced-motion: reduce){
    .window{ animation: none; }
  }

  @media (max-width: 520px){
    .wrap{ padding: 8px; }
    .window{
      width: 100%;
      height: calc(100vh - 16px);
      clip-path: polygon(14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%, 0 14px);
    }
    .window::before, .window::after{ width: 16px; height: 16px; }
    .content{ padding: 12px; }
  }
</style>
